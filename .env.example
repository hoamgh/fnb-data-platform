# Local analytics ports (loopback only); no passwords belong in this file.
FNB_POSTGRES_PORT=15433
FNB_SUPERSET_PORT=18089
# Isolated DuckDB runner defaults: Superset 18089, metadata PostgreSQL 15433.
FNB_DBT_DOCS_PORT=18081
# Profiles/working DuckDB paths are selected by the runner, not configured here.
# FNB_AREA_DBT_RELEASE=/demo/path/to/published/area/releases/<release-id>
# The isolated runner generates missing secrets in its ignored run directory.
